; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ideation_for_finger_drag_netball_concept"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280.0
window/size/viewport_height=720.0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1.0

[dotnet]

project/assembly_name="ideation_for_finger_drag_netball_concept"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.16, 0.28, 0.34, 1)
